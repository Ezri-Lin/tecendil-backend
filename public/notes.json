      "{lang:Sindarin}",
      "",
      "<div class='two-columns'>",
      "{{sindarin:",
      "Elessar Telcontar",
      "Aragorn Arathornion",
      "Edhelharn, aran Gondor ar Hîr i Mbair",
      "Annui, anglennatha i Varanduiniant erin",
      "dolothen Ethuil, egor ben genediad",
